{
  "name": "fm-dx-console",
  "version": "1.61.0",
  "description": "Console client for fm-dx-webserver",
  "type": "module",
  "main": "src/desktop/main.cjs",
  "bin": {
    "fm-dx-console": "src/cli.jsx"
  },
  "scripts": {
    "start": "tsx src/cli.jsx",
    "electron": "electron .",
    "test": "node scripts/test.js",
    "lint": "eslint src scripts",
    "build:cli": "node scripts/build-cli.js",
    "package:cli": "npm run build:cli && node scripts/package-cli.js",
    "package:gui": "electron-builder --config packaging/electron-builder.yml --publish never",
    "smoke:cli": "node scripts/smoke-cli.js",
    "smoke:gui": "node scripts/smoke-gui.js",
    "release:check": "node scripts/release-check.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "minimist": "^1.2.8",
    "react": "^19.3.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "license": "GPL-3.0-only",
  "author": "Mark de Bruijn",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkram/fm-dx-console.git"
  },
  "homepage": "https://github.com/bkram/fm-dx-console#readme"
}
